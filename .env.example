# FastAPI backend base URL, as reached from the browser (see ../backend)
NEXT_PUBLIC_API_URL=http://localhost/api

# web_worker WebSocket base URL, room-scoped at /ws/{stack_box_id} (see ../web_worker)
NEXT_PUBLIC_WORKER_URL=ws://localhost:3000

# Backend base URL as reached from the Next.js server itself. Only used by
# Route Handlers (app/api/**), which run server-side and cannot use the
# browser's localhost inside Docker. Leave unset outside compose.
# API_INTERNAL_URL=http://backend:8000
